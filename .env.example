# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Session Security
SESSION_SECRET=super-secret-smart-campus-session-key-change-in-production-2026
SESSION_MAX_AGE_MS=86400000

# Primary MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_campus_db
DB_CONNECTION_LIMIT=10

# Test Database Configuration
DB_NAME_TEST=smart_campus_test
DB_USER_TEST=root
DB_PASSWORD_TEST=your_mysql_password
DB_HOST_TEST=localhost
DB_PORT_TEST=3306

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

