{
  "name": "smart-campus-management-system",
  "version": "1.0.0",
  "description": "Production-grade University DBMS & Campus Management System",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm run start --workspace=server",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "db:init": "node server/scripts/init-db.js",
    "db:seed": "node server/scripts/init-db.js --seed-only"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "campus-management",
    "university-dbms",
    "mysql",
    "express",
    "react",
    "rbac"
  ],
  "author": "Smart Campus Engineering Team",
  "license": "ISC"
}

